<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ requires a specific foreground-service type permission alongside
         the generic one above; this service syncs orders/health with the backend. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required for TelephonyManager.sendUssdRequest() and per-SIM subscription lookup (dual-SIM routing) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Android 13+ requires this for any local notification (order updates, etc.) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vibration for the payment-alert notification channel (see MainActivity.createNotificationChannel) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Held briefly around the actual USSD dial-and-wait (UssdDialer.dial) so the
         device sleeping mid-request can't cut off the carrier's callback. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Requested via PermissionsStatusScreen's own consent prompt, not at first
         launch — Android reserves this for apps whose core function genuinely needs
         to keep running unattended in the background, which the payment-monitoring
         service is. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".DalabAgentApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.DalabAgentApp"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DalabAgentApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Protected system broadcast — a manifest-declared receiver still fires even
          on API 26+ where most implicit broadcasts are restricted in the background.
          android:permission=BROADCAST_SMS stops any app other than the SMS provider
          from spoofing this broadcast into the receiver.
        -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".sms.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.AgentBackgroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
