NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=
ENCRYPTION_KEY=
CORS_ORIGIN=https://your-admin-dashboard.example.com
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
# Optional — Hormuud SMS Business API (https://smsapi.hormuud.com), used to
# actually text OTP codes. Without these, OTP requests fall back to
# test-mode (the code is returned directly in the API response instead of
# being sent by SMS).
HORMUUD_SMS_USERNAME=
HORMUUD_SMS_PASSWORD=
HORMUUD_SMS_SENDER_ID=DALAB
