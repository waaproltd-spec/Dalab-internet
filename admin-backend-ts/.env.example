NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=
ENCRYPTION_KEY=
CORS_ORIGIN=https://your-admin-dashboard.example.com
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
# Optional — customer push notifications (Admin > Notifications) work as an
# in-app-only inbox without this. Paste the ENTIRE contents of the service
# account key file from Firebase Console -> Project Settings -> Service
# Accounts -> Generate new private key, as one line, to enable real pushes.
FIREBASE_SERVICE_ACCOUNT_JSON=
