NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=
ENCRYPTION_KEY=
CORS_ORIGIN=https://your-admin-dashboard.example.com
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

# Only required for a company set to fulfillment_method='somlink' — see
# src/services/somlink.ts. SOMLINK_PHONE/SOMLINK_PASSWORD are the wallet
# account's login credentials, never the customer's own phone number.
SOMLINK_BASE_URL=https://api.data.somlink.net
SOMLINK_PHONE=
SOMLINK_PASSWORD=

# Device Activation (routes/deviceActivation.routes.ts): agent APIs only answer
# admin-approved Agent App installs. Set to false until every agent runs an
# Agent App build that sends X-Agent-Install-Id, or older APKs are locked out.
DEVICE_ACTIVATION_REQUIRED=true
# How long a device activation code stays valid (minutes).
DEVICE_ACTIVATION_CODE_TTL_MINUTES=15
